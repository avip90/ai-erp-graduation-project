    {
      "parameters": {
        "jsCode": "const f = $json.fields;\nconst interest = f.Interest || 'המוצרים שלנו';\nconst name = f.Name || 'לקוח יקר';\n\nconst subject = `${name}, התאמנו לך משהו ב${interest}`;\nconst body = `\n<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #12161C; line-height: 1.6;\">\n  <p>שלום ${name},</p>\n  <p>ראינו שאתם מתעניינים ב<b>${interest}</b> — רצינו להכיר לכם את המבחר שלנו באיי.איי אלקטרוניקה.</p>\n  <p>יש לנו מגוון רחב, אחריות יבואן מלאה על כל מוצר, וצוות מקצועי שישמח לייעץ בהתאמה בדיוק לצורך שלכם.</p>\n  <p>נשמח לשמוע מכם ולעזור למצוא את הפתרון המתאים.</p>\n  <p>בברכה,<br>צוות איי.איי אלקטרוניקה ⚡</p>\n</div>\n`;\n\nreturn { json: { to: f.Email, subject, body, recordId: $json.id } };"
      },
