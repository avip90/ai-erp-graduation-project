    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $json;\nconst count = f.contactCount; // 1, 2, or 3 (לפני השליחה הנוכחית)\n\nconst angles = {\n  1: {\n    subject: `עדיין רלוונטי? - ${f.interest || 'ציוד לעסק'}`,\n    body: `שלום ${f.name},\n\nרציתי לחזור בקצרה לגבי הפנייה בנושא ${f.interest || 'ציוד אלקטרוניקה'}.\nיש לנו כרגע מבצעי כמות שעשויים להתאים - אשמח לשלוח פרטים אם עדיין רלוונטי.\n\nבברכה, צוות איי.איי אלקטרוניקה`\n  },\n  2: {\n    subject: `דגמים מומלצים - ${f.interest || 'ציוד לעסק'}`,\n    body: `שלום ${f.name},\n\nחשבתי שיעניין אתכם לראות כמה דגמים ספציפיים שמתאימים לצרכים כמו שלכם.\nאשמח לשלוח גיליון השוואה קצר - רק תאשרו ואני שולח.\n\nבברכה, צוות איי.איי אלקטרוניקה`\n  },\n  3: {\n    subject: `פנייה אחרונה - ${f.interest || 'ציוד לעסק'}`,\n    body: `שלום ${f.name},\n\nזו הפנייה האחרונה מצדי בנושא - לא רוצה להעמיס.\nאם יש עניין בעתיד, אני כאן. אם לא רלוונטי כרגע - אפשר פשוט להשיב \"לא כרגע\" ולא אפריע יותר.\n\nבברכה, צוות איי.איי אלקטרוניקה`\n  }\n};\n\nconst chosen = angles[count] || angles[1];\n\nreturn {\n  json: {\n    recordId: f.recordId,\n    email: f.email,\n    contactCount: f.contactCount,\n    subject: chosen.subject,\n    body: chosen.body\n  }\n};"
      },
