    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const f = item.json.fields;\n  const lastContacted = f.LastContactedAt ? new Date(f.LastContactedAt).getTime() : new Date(f.Created).getTime();\n  const daysSince = (now - lastContacted) / (1000 * 60 * 60 * 24);\n  const contactCount = f.ContactCount || 0;\n\n  if (daysSince < 3) continue; // עוד לא הגיע הזמן\n\n  results.push({\n    json: {\n      recordId: item.json.id,\n      name: f.Name,\n      email: f.Email,\n      interest: f.Interest,\n      contactCount,\n      group: contactCount >= 4 ? 'B_giveUp' : 'A_followUp'\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        -128
      ],
      "id": "062ea67d-98b1-4058-856c-ad950fbfd470",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "4020545e-f876-4a1c-9e73-c3a14ca8d6bc",
              "leftValue": "={{ $json.group }}",
              "rightValue": "A_followUp",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
