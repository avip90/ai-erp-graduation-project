        "mode": "runOnceForEachItem",
        "jsCode": "const BASE_ID = 'appdB6Amrw3JWFCUH'; // * להחליף ב-Base ID האמיתי\nconst rec = $json;\nconst fields = rec.fields || {};\nconst email = (fields.Email || '').trim();\nconst company = (fields.Company || '').trim();\n\nconst clauses = [];\nif (email) clauses.push(`{Email}='${email.replace(/'/g, \"\\\\'\")}'`);\nif (company) clauses.push(`{Company}='${company.replace(/'/g, \"\\\\'\")}'`);\n\nif (clauses.length === 0) {\n  // אין מספיק מידע (לא Email ולא Company) — מדלגים על בדיקת כפילות\n  return { json: { recordId: rec.id, fields, skip: true } };\n}\n\nconst orClause = clauses.length > 1 ? `OR(${clauses.join(',')})` : clauses[0];\nconst formula = `AND(NOT(RECORD_ID()='${rec.id}'), ${orClause})`;\nconst searchUrl = `https://api.airtable.com/v0/${BASE_ID}/Leads?filterByFormula=${encodeURIComponent(formula)}`;\n\nreturn { json: { recordId: rec.id, fields, skip: true } };"
      },
