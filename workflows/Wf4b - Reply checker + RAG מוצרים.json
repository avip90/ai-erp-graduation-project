    {
      "parameters": {
        "jsCode": "let replyText = '';\nlet leadStatus = 'Contacted';\nconst raw = $json.output || $json.content?.[0]?.text || '';\n\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  replyText = parsed.reply || raw;\n  leadStatus = parsed.leadStatus || 'Contacted';\n} catch (e) {\n  replyText = raw || 'שגיאה בניתוח תגובת ה-AI - יש לבדוק ידנית';\n}\n\n// עיטוף ב-HTML עם כיוון RTL מפורש, כדי שעברית מעורבת במספרים/אנגלית תוצג נכון\nconst htmlReply = `<div dir=\"rtl\" style=\"text-align:right; font-family:Arial,sans-serif; font-size:14px; line-height:1.6;\">${replyText.replace(/\\n/g, '<br>')}</div>`;\n\nreturn { json: { replyText: htmlReply, leadStatus } };"
      },
