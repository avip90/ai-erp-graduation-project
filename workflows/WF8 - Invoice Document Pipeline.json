    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $json.fields || {};\nconst dateStr = new Date(f.Created).toLocaleDateString('he-IL');\n\nconst html = `<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<title>חשבונית ${f.InvoiceNumber || ''}</title>\n<style>\n  body { font-family: Arial, sans-serif; padding: 40px; color: #12161C; }\n  .header { display: flex; justify-content: space-between; border-bottom: 3px solid #0F9E96; padding-bottom: 16px; margin-bottom: 24px; }\n  .brand { font-size: 22px; font-weight: 800; }\n  .invoice-title { font-size: 18px; color: #5B6472; }\n  table { width: 100%; border-collapse: collapse; margin-top: 20px; }\n  td, th { padding: 10px; border-bottom: 1px solid #E2E6EC; text-align: right; }\n  .total-row { font-weight: 800; font-size: 16px; background: #F6F7F9; }\n</style>\n</head>\n<body>\n  <div class=\"header\">\n    <div class=\"brand\">⚡ איי.איי אלקטרוניקה</div>\n    <div class=\"invoice-title\">חשבונית מס' ${f.InvoiceNumber || ''}</div>\n  </div>\n  <p><b>מזהה לקוח:</b> ${f.CustomerId || ''}</p>\n  <p><b>תאריך:</b> ${dateStr}</p>\n  <table>\n    <tr><th>תיאור</th><th>סכום</th></tr>\n    <tr><td>סכום לפני מע\"מ</td><td>₪${(f.Amount || 0).toFixed(2)}</td></tr>\n    <tr><td>מע\"מ (18%)</td><td>₪${(f.VatAmount || 0).toFixed(2)}</td></tr>\n    <tr class=\"total-row\"><td>סה\"כ לתשלום</td><td>₪${(f.Total || 0).toFixed(2)}</td></tr>\n  </table>\n  <p style=\"margin-top:30px; color:#5B6472; font-size:12px;\">מסמך זה הופק אוטומטית ע\"י מערכת ה-AI-ERP.</p>\n</body>\n</html>`;\n\nconst binaryData = await this.helpers.prepareBinaryData(\n  Buffer.from(html, 'utf-8'),\n  `${f.InvoiceNumber}.html`,\n  'text/html'\n);\n\nreturn {\n  json: { invoiceNumber: f.InvoiceNumber, recordId: $json.id },\n  binary: { data: binaryData }\n};"
      },
